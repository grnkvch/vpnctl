{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpnctl.dev/schemas/v2/results/resource-v1.schema.json",
  "title": "vpnctl v2 resource detail result",
  "allOf": [
    { "$ref": "../common-result-v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "command": {
          "enum": [
            "cert.show", "client.show", "dns.show", "expose.show", "node.show", "policy.show",
            "preset.show", "transport.host.show", "trust.show"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource"],
          "properties": {
            "resource": { "$ref": "../common-result-v1.schema.json#/$defs/safe_object" }
          }
        }
      }
    }
  ]
}
