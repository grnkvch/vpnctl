{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpnctl.dev/schemas/v2/results/secret-issue-v1.schema.json",
  "title": "vpnctl v2 one-time secret issuance metadata result",
  "allOf": [
    { "$ref": "../common-result-v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "command": { "enum": ["invite", "node.recover"] },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["displayed_to_tty", "expires_at"],
          "properties": {
            "displayed_to_tty": { "const": true },
            "expires_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            }
          }
        }
      }
    }
  ]
}
