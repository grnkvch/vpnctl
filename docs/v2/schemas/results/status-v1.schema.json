{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpnctl.dev/schemas/v2/results/status-v1.schema.json",
  "title": "vpnctl v2 passive status result",
  "allOf": [
    { "$ref": "../common-result-v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "command": { "enum": ["status", "log.status"] },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "overall", "generation"],
          "properties": {
            "role": { "enum": ["gateway", "node"] },
            "overall": { "enum": ["healthy", "degraded", "failed"] },
            "generation": { "type": "integer", "minimum": 0 },
            "counts": { "$ref": "../common-result-v1.schema.json#/$defs/safe_object" },
            "resources": {
              "type": "array",
              "items": { "$ref": "../common-result-v1.schema.json#/$defs/safe_object" }
            }
          }
        }
      }
    }
  ]
}
