{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpnctl.dev/schemas/v2/results/operation-v1.schema.json",
  "title": "vpnctl v2 mutation or convergence result",
  "allOf": [
    { "$ref": "../common-result-v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "command": {
          "enum": [
            "apply", "cert.rotate", "client.add", "client.delete", "client.revoke", "client.rotate",
            "confirm", "dns.reset", "dns.set", "expose", "expose.remove", "init.gateway", "init.node",
            "invite.cancel", "join", "log.disable", "log.enable", "node.delete", "node.recover",
            "node.revoke", "node.rotate", "policy.clear", "policy.set", "preset.update", "purge", "repair",
            "restore", "transport.host.commit", "transport.host.prepare", "transport.host.recover",
            "transport.host.rollback", "transport.switch", "trust.commit", "trust.rollback", "trust.rotate",
            "uninstall", "update", "update.rollback"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["changed"],
          "properties": {
            "changed": { "type": "boolean" },
            "dry_run": { "type": "boolean" },
            "operation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "snapshot_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "generation": { "type": "integer", "minimum": 0 },
            "scope": { "enum": ["control", "transport", "routing", "dns", "tunnel", "ingress", "all"] },
            "disabled_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "uniqueItems": true
            },
            "expired_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "uniqueItems": true
            },
            "enabled": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "scope", "level", "destination", "started_at", "expires_at", "remaining_seconds"],
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
                "scope": { "enum": ["control", "transport", "routing", "dns", "tunnel", "ingress", "all"] },
                "level": { "enum": ["error", "info", "debug", "trace"] },
                "destination": { "enum": ["journald", "file"] },
                "started_at": { "type": "string", "format": "date-time" },
                "expires_at": { "type": "string", "format": "date-time" },
                "remaining_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 }
              }
            },
            "repair_count": { "type": "integer", "minimum": 0 },
            "repairs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["component", "resource_kind", "resource_id", "drift_kind", "action", "impact"],
                "properties": {
                  "component": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "resource_kind": { "enum": ["file", "unit", "network", "state"] },
                  "resource_id": { "type": "string", "minLength": 1, "maxLength": 4096 },
                  "drift_kind": { "enum": ["missing", "modified", "unexpected"] },
                  "action": { "enum": ["restore", "remove"] },
                  "impact": { "enum": ["none", "availability", "destructive"] },
                  "target_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "observed_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            },
            "expose_state": { "enum": ["ready", "degraded"] },
            "fingerprint": { "type": "string", "minLength": 1, "maxLength": 128 },
            "output_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "scp_command": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "role": { "enum": ["gateway", "node"] },
            "requested_version": { "type": "string", "maxLength": 65 },
            "latest_stable": { "type": "boolean" },
            "current_version": { "type": "string", "minLength": 1, "maxLength": 65 },
            "previous_version": { "type": "string", "minLength": 1, "maxLength": 65 },
            "target_version": { "type": "string", "minLength": 1, "maxLength": 65 },
            "blocked": { "type": "boolean" },
            "force_required": { "type": "boolean" },
            "local_only": { "type": "boolean" },
            "include_backups": { "type": "boolean" },
            "backup_archives": { "type": "integer", "minimum": 0 },
            "node_revoked": { "type": "boolean" },
            "gateway_generation": { "type": "integer", "minimum": 0 },
            "dns_restored": { "type": "boolean" },
            "network_restored": { "type": "boolean" },
            "managed_swap_disabled": { "type": "boolean" },
            "managed_swap_purged": { "type": "boolean" },
            "data_purged": { "type": "boolean" },
            "backups_removed": { "type": "boolean" },
            "binary_removed": { "type": "boolean" },
            "installer_binary_retained": { "type": "boolean" },
            "active_node_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "uniqueItems": true
            },
            "active_client_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "uniqueItems": true
            },
            "active_expose_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "uniqueItems": true
            },
            "preserved": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "uniqueItems": true
            },
            "removed": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "uniqueItems": true
            },
            "rollback_available": { "type": "boolean" },
            "affected_services": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 128 },
              "uniqueItems": true
            },
            "expected_interruptions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "changed"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "current_version": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "target_version": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "bundled": { "type": "boolean" },
                  "changed": { "type": "boolean" },
                  "file_changed": { "type": "boolean" },
                  "affected_services": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1, "maxLength": 128 },
                    "uniqueItems": true
                  },
                  "healthy": { "type": "boolean" },
                  "rolled_back": { "type": "boolean" }
                }
              }
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["component", "package", "installed_version", "compatible"],
                "properties": {
                  "component": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "package": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "installed_version": { "type": "string", "maxLength": 128 },
                  "compatible": { "type": "boolean" }
                }
              }
            },
            "fleet": {
              "type": "object",
              "additionalProperties": false,
              "required": ["compatible", "selected_protocol", "gateway_version", "nodes"],
              "properties": {
                "compatible": { "type": "boolean" },
                "selected_protocol": { "type": "string", "maxLength": 32 },
                "gateway_version": { "type": "string", "maxLength": 65 },
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "name", "control_protocol", "compatible", "code"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                      "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                      "control_protocol": { "type": "string", "maxLength": 32 },
                      "compatible": { "type": "boolean" },
                      "code": { "type": "string", "maxLength": 128 }
                    }
                  }
                }
              }
            },
            "migration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from_schema", "to_schema", "steps", "reversible"],
              "properties": {
                "from_schema": { "type": "integer", "minimum": 1 },
                "to_schema": { "type": "integer", "minimum": 0 },
                "steps": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                },
                "reversible": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  ]
}
