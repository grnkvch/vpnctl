{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpnctl.dev/schemas/v2/signed-release-manifest-v1.schema.json",
  "title": "vpnctl signed release manifest envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "key_id", "payload", "signature"],
  "properties": {
    "schema_version": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "key_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 699051,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "signature": {
      "type": "string",
      "minLength": 86,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
