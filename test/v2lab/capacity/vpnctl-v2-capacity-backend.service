[Unit]
Description=vpnctl v2 capacity private-node webhook fixture
After=network.target

[Service]
Type=simple
DynamicUser=true
ExecStart=/usr/local/libexec/vpnctl-v2-capacity/webhook-receiver --listen 127.0.0.1 --port 18121
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=64M
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
