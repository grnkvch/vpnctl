[Unit]
Description=vpnctl v2 capacity full controller fixture
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/vpnctl-v2-capacity/controller --root /var/lib/vpnctl-v2-capacity/controller-root serve
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vpnctl-v2-capacity
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=64M
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
