[Unit]
Description=vpnctl v2 credential-free webhook receiver spike
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/vpnctl-v2-spike/webhook-receiver --listen 127.0.0.1 --port 18081
Restart=on-failure
RestartSec=1s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=32M

[Install]
WantedBy=multi-user.target
