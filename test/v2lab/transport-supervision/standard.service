[Unit]
Description=vpnctl task 8.6 standard-listener supervision gate
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=@RUNTIME_ROOT@/listener --network udp4 --address 0.0.0.0:19091
Restart=on-failure
RestartSec=2s
StandardOutput=null
StandardError=null
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
