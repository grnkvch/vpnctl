{
  "schema_version": 1,
  "status": "spike-only",
  "pki": {
    "algorithm": "Ed25519",
    "serial_bits": 128,
    "ca_validity_days": 3650,
    "leaf_validity_days": 1825,
    "renewal_window_days": 180,
    "node_uri_template": "urn:vpnctl:node:<uuid>",
    "gateway_uri_template": "urn:vpnctl:gateway:<uuid>"
  },
  "enrollment": {
    "algorithm": "Ed25519",
    "transcript": "vpnctl-enrollment-transcript-v1",
    "invite_secret_bytes": 32,
    "nonce_bytes": 16,
    "clock_skew_seconds": 120
  },
  "rpc": {
    "protocol": "1.0",
    "path_prefix": "/rpc/v1/",
    "tls_minimum": "1.3",
    "http": "1.1",
    "request_bytes": 65536,
    "response_bytes": 262144,
    "header_bytes": 8192,
    "max_json_depth": 32,
    "read_header_seconds": 2,
    "read_body_seconds": 5,
    "write_seconds": 5,
    "idle_seconds": 5,
    "max_concurrent_connections": 16
  }
}
