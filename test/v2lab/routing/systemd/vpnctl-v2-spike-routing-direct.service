[Unit]
Description=vpnctl v2 routing direct-path fixture
After=network.target

[Service]
Type=simple
NetworkNamespacePath=/run/netns/vpnctl-v2-rdirect
ExecStart=/usr/local/libexec/vpnctl-v2-spike-routing/backend --state /run/vpnctl-v2-spike-routing/direct.json --tcp 203.0.113.10:18080=direct-selected --udp 203.0.113.10:18080=direct-selected --tcp 203.0.113.20:18080=direct-unmatched --udp 203.0.113.20:18080=direct-unmatched --tcp [2001:db8:1::10]:18080=direct-v6-selected --udp [2001:db8:1::10]:18080=direct-v6-selected --tcp [2001:db8:1::20]:18080=direct-v6-unmatched --udp [2001:db8:1::20]:18080=direct-v6-unmatched
Restart=on-failure
RestartSec=1s
StandardOutput=null
StandardError=null
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/run/vpnctl-v2-spike-routing
MemoryMax=32M
TasksMax=64

[Install]
WantedBy=multi-user.target
