[Unit]
Description=vpnctl v2 routing gateway-path fixture
After=network.target

[Service]
Type=simple
NetworkNamespacePath=/run/netns/vpnctl-v2-rgateway
ExecStart=/usr/local/libexec/vpnctl-v2-spike-routing/backend --state /run/vpnctl-v2-spike-routing/gateway.json --tcp 203.0.113.10:18080=gateway-selected --udp 203.0.113.10:18080=gateway-selected --tcp 10.202.0.1:19000=recovery --udp 10.202.0.1:19000=recovery
Restart=on-failure
RestartSec=1s
StandardOutput=null
StandardError=null
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/run/vpnctl-v2-spike-routing
MemoryMax=32M
TasksMax=64

[Install]
WantedBy=multi-user.target
