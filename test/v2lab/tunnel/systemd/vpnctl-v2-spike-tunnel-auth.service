[Unit]
Description=vpnctl v2 tunnel authorization spike
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/vpnctl-v2-spike/tunnel-auth-plugin serve --state /var/lib/vpnctl-v2-spike-tunnel-auth/state.json --metrics /var/lib/vpnctl-v2-spike-tunnel-auth/metrics.json --listen 127.0.0.1 --port 19091
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vpnctl-v2-spike-tunnel-auth
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
MemoryMax=64M
TasksMax=32
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
