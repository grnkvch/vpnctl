[Unit]
Description=vpnctl v2 private-node tunnel backend spike
After=network.target

[Service]
Type=simple
DynamicUser=true
ExecStart=/usr/local/libexec/vpnctl-v2-spike/tunnel-backend --listen 127.0.0.1 --backend 18121=backend-one --backend 18122=backend-two
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
MemoryMax=64M
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
