[Unit]
Description=vpnctl v2 shared frps tunnel spike
After=network-online.target vpnctl-v2-spike-tunnel-auth.service
Wants=network-online.target
Requires=vpnctl-v2-spike-tunnel-auth.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/vpnctl-v2-spike/frps -c /etc/vpnctl-v2-spike/tunnel/frps.toml
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/vpnctl-v2-spike/tunnel
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
MemoryMax=96M
TasksMax=64
LimitNOFILE=512

[Install]
WantedBy=multi-user.target
